{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": { "@tegg/doc": ["../packages/doc/src/index.ts"], "@tegg/editor": ["../packages/editor/src/index.ts"] }
  },
  "include": ["test/*.ts", "webkit/*.ts", "ui/test/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["test/bug_*.test.ts"]
}
