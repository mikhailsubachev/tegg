{
  "name": "tegg-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Tegg desktop app: Tauri 2 shell + React UI (docs/contracts/ms2-shell.md)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app",
    "app:preview": "tauri build --bundles app --config src-tauri/tauri.preview.conf.json --features preview && mkdir -p ~/Applications && rm -rf ~/Applications/'Tegg Preview.app' && ditto 'src-tauri/target/release/bundle/macos/Tegg Preview.app' ~/Applications/'Tegg Preview.app'",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "test:webkit": "playwright test",
    "test:e2e": "node --import ./e2e/helpers/l6-guard.ts --test --test-concurrency=1 --test-reporter=spec e2e/*.ac.test.ts",
    "e2e:setup": "APPIUM_HOME=e2e/.appium appium driver install mac2 && APPIUM_HOME=e2e/.appium appium driver run mac2 open-wda"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "d3-force": "3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "3.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "appium": "^3.8.0",
    "axe-core": "^4.14.0",
    "dom-accessibility-api": "^0.7.1",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "webdriverio": "^10.0.2"
  }
}
