{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tegg S3",
  "version": "0.0.0",
  "identifier": "app.tegg.spike-s3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Tegg S3",
        "url": "index.html",
        "width": 720,
        "height": 520
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "url": "capture.html",
        "width": 520,
        "height": 300,
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
