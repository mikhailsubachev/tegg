{
  "name": "s3-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app,dmg",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/icons/source.png"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
