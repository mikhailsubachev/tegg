{
  "about": "Shared excerpt corpus (docs/contracts/ms4-links.md §2, D-277; FR-LNK-01 AC-4). Read by crates/tegg-format/tests/ac_excerpt.rs and packages/doc/test/excerpt.ac.test.ts. Synthetic (D-50).",
  "rules": [
    "cases[].links: every link record of extract() in file order: at = 1-based line in the file and 0-based UTF-8 byte offset of the link start in that line; block = index into blocks, null in frontmatter; target compared after NFC (null: not checked); embed checked when given",
    "cases[].blocks: one entry per body block with at least one link, in file order; kind is paragraph | heading | listItem | tableRow | quote | callout",
    "segments: {text, marks} or {link: <index into links>, marks}; marks are strong | em | code | strike | highlight; adjacent text with equal marks is one segment",
    "windows[]: excerptWindow(rendered, here, max, before) / tegg_format::excerpt::window; characters are Unicode scalar values of the rendered text, chips included; a cut drops the whitespace at the cut"
  ],
