{
  "steps": [
    { "id": "qa-tools-typecheck", "lane": "node", "dir": "tools/qa", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s1-typecheck", "lane": "node", "dir": "spikes/s1-roundtrip", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "core-rust-check", "lane": "cargo", "inputs": ["crates","Cargo.toml","Cargo.lock"], "dir": "crates", "run": "cargo check --workspace --tests --quiet", "level": "commit", "changedOnly": true },
    { "id": "doc-typecheck", "lane": "node", "dir": "packages/doc", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "core-rust-test", "lane": "cargo", "inputs": ["crates","Cargo.toml","Cargo.lock","tests/fixtures","tools/gen-vault","packages/doc","tools/qa/src/cargo-junit.ts"], "dir": ".",
      "run": "cargo test --workspace --lib --quiet && node tools/qa/src/cargo-junit.ts --junit \"$VERIFY_RESULTS/core-rust-ac.xml\" --threads 2 --serial crates/tegg-format/tests/ac_format.rs $(ls crates/*/tests/ac_*.rs 2>/dev/null | grep -v '/ac_perf_headroom\\.rs$' | grep -v '^crates/tegg-jobs/') -- --skip nfr_perf_ --skip fr_nav_01_ac9_ --skip fr_src_01_ac11_",
      "level": "push" },
    { "id": "jobs-test", "lane": "cargo", "inputs": ["crates","Cargo.toml","Cargo.lock","tests/fixtures","tools/gen-vault","packages/doc","tools/qa/src/cargo-junit.ts"], "dir": ".",
      "run": "npm run --silent --prefix packages/doc build && node tools/qa/src/cargo-junit.ts --junit \"$VERIFY_RESULTS/jobs-ac.xml\" --threads 2 $(ls crates/tegg-jobs/tests/ac_*.rs 2>/dev/null)",
      "level": "push" },
    { "id": "core-perf-ac", "lane": "cargo", "dir": ".",
      "run": "node tools/qa/src/cargo-junit.ts --junit \"$VERIFY_RESULTS/core-perf-ac.xml\" crates/tegg-core/tests/ac_perf.rs crates/tegg-core/tests/ac_perf_headroom.rs",
      "level": "nightly" },
    { "id": "doc-test", "lane": "node", "inputs": ["packages/doc","tests/fixtures"], "dir": "packages/doc",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/doc.xml\" --passWithNoTests",
      "level": "push" },
    { "id": "qa-tools-test", "lane": "node", "inputs": ["tools/qa","verify","qa.config.json",".githooks",".claude","docs"], "dir": "tools/qa",
      "run": "node --test --test-concurrency=2 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$VERIFY_RESULTS/qa-tools.xml\" 'test/*.test.ts'",
      "level": "push" },
    { "id": "schema-typecheck", "lane": "node", "dir": "packages/schema", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "schema-test", "lane": "node", "inputs": ["packages/schema","tests/fixtures"], "dir": "packages/schema",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/schema.xml\"",
      "level": "push" },
    { "id": "editor-typecheck", "lane": "node", "dir": "packages/editor", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "editor-test", "lane": "node", "inputs": ["packages/editor","packages/doc","packages/schema","tests/fixtures"], "dir": "packages/editor",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/editor.xml\"",
      "level": "push" },
    { "id": "app-typecheck", "lane": "node", "dir": "app", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "app-shell-test", "lane": "cargo", "inputs": ["app","packages","crates","tests/fixtures","tools/gen-vault"], "dir": "app", "run": "npx vite build --logLevel error && cargo test --quiet --manifest-path src-tauri/Cargo.toml && node --test test/bug_*.test.ts", "level": "push" },
    { "id": "app-test-typecheck", "lane": "node", "dir": "app", "run": "npx tsc -p tsconfig.test.json && npx tsc --noEmit -p e2e/tsconfig.json", "level": "commit", "changedOnly": true },
    { "id": "app-ui-test", "lane": "browser", "inputs": ["app","packages","crates","tests/fixtures","tools/gen-vault"], "dir": "app",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/app-ui.xml\"",
      "level": "push" },
    { "id": "app-webkit", "lane": "browser", "inputs": ["app","packages","crates","tests/fixtures","tools/gen-vault"], "dir": "app",
      "run": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=\"$VERIFY_RESULTS/app-webkit.xml\" npx playwright test --reporter=list,junit",
      "level": "push" },
    { "id": "s2-typecheck", "lane": "node", "dir": "spikes/s2-editor", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s2-test", "lane": "node", "inputs": ["spikes/s2-editor","spikes/s1-roundtrip","tests/fixtures"], "dir": "spikes/s2-editor",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/s2-editor.xml\"",
      "level": "push" },
    { "id": "s2-webkit", "lane": "browser", "dir": "spikes/s2-editor",
      "run": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=\"$VERIFY_RESULTS/s2-webkit.xml\" npx playwright test --project=webkit e2e/editor-flow.spec.ts --reporter=list,junit",
      "level": "nightly" },
    { "id": "s1-test", "lane": "node", "inputs": ["spikes/s1-roundtrip","tests/fixtures"], "dir": "spikes/s1-roundtrip",
      "run": "npx vitest run --maxWorkers 2 --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/s1-roundtrip.xml\"",
      "level": "push" },
    { "id": "s3-typecheck", "lane": "node", "dir": "spikes/s3-platform", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s3-appium-typecheck", "lane": "node", "dir": "spikes/s3-platform/e2e-appium", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s3-rust-test", "lane": "cargo", "inputs": ["spikes/s3-platform/src-tauri"], "dir": "spikes/s3-platform/src-tauri", "run": "cargo test --quiet", "level": "push" },
    { "id": "gen-vault-test", "lane": "cargo", "inputs": ["tools/gen-vault"], "dir": "tools/gen-vault", "run": "cargo test --quiet", "level": "push" },
    { "id": "s4-test", "lane": "cargo", "inputs": ["spikes/s4-index","spikes/s1-roundtrip","tools/gen-vault","tests/fixtures"], "dir": "spikes/s4-index", "run": "cargo test --release --quiet", "level": "push" },
    { "id": "s4-differential", "lane": "cargo", "dir": "spikes/s1-roundtrip",
      "run": "D=$(mktemp -d); trap 'rm -rf $D' EXIT; EXTRACT_DIFF_OUT=$D npx vitest run test/extract-diff.test.ts --silent=false && S4_EXTRACT_DIFF=$D/corpus.json cargo test --release --quiet --manifest-path ../s4-index/Cargo.toml --test conformance -- --nocapture",
      "level": "nightly" },
    { "id": "s5-test", "lane": "cargo", "inputs": ["spikes/s5-capacities-import","tests/fixtures"], "dir": "spikes/s5-capacities-import", "run": "cargo test --release --quiet", "level": "push" },
    { "id": "core-perf", "lane": "cargo", "dir": "tools/core-perf",
      "run": "D=$(mktemp -d) && cargo run --release --quiet --manifest-path ../gen-vault/Cargo.toml -- --seed 1 --small-images --out $D/vault && cargo run --release --quiet -- --vault $D/vault --runs 20 --out \"$VERIFY_RESULTS/core-perf.json\"; S=$?; rm -rf $D; exit $S",
      "level": "nightly" },
    { "id": "s4-perf", "lane": "cargo", "dir": "spikes/s4-index",
      "run": "D=$(mktemp -d) && cargo run --release --quiet --manifest-path ../../tools/gen-vault/Cargo.toml -- --seed 1 --small-images --out $D/vault && cargo run --release --quiet --bin perf -- --vault $D/vault --runs 20 --out \"$VERIFY_RESULTS/s4-perf.json\"; S=$?; rm -rf $D; exit $S",
      "level": "nightly" },
    { "id": "app-e2e", "lane": "browser", "dir": "app", "cargoCache": false,
      "run": "npm run --silent app:build && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$VERIFY_RESULTS/app-e2e.xml\" $(ls e2e/*.ac.test.ts | grep -v '/nfr_perf_' | grep -v '/nightly_')",
      "level": "milestone" },
    { "id": "app-e2e-nightly", "lane": "browser", "dir": "app", "cargoCache": false,
      "run": "npm run --silent app:build && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$VERIFY_RESULTS/app-e2e-nightly.xml\" e2e/nightly_*.ac.test.ts",
      "level": "nightly" },
    { "id": "app-perf", "lane": "browser", "dir": "app", "cargoCache": false,
      "run": "npm run --silent app:build && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$VERIFY_RESULTS/app-perf.xml\" e2e/nfr_perf_*.ac.test.ts",
      "level": "milestone" }
  ],
  "acTestPatterns": ["\\.ac\\.test\\.tsx?$", "(^|/)tests/ac_[^/]+\\.rs$"],
  "acRunners": [
    { "dir": ".", "match": "^crates/[^/]+/tests/ac_[^/]+\\.rs$",
      "run": "node tools/qa/src/cargo-junit.ts --junit {junit} {files}" },
    { "dir": "packages/doc", "match": "^packages/doc/test/.*\\.ac\\.test\\.ts$",
      "run": "npx vitest run --reporter=junit --outputFile.junit={junit} {files}" },
    { "dir": "packages/schema", "match": "^packages/schema/test/.*\\.ac\\.test\\.ts$",
      "run": "npx vitest run --reporter=junit --outputFile.junit={junit} {files}" },
    { "dir": "packages/editor", "match": "^packages/editor/test/.*\\.ac\\.test\\.ts$",
      "run": "npx vitest run --reporter=junit --outputFile.junit={junit} {files}" },
    { "dir": "tools/qa", "match": "^tools/qa/test/.*\\.ac\\.test\\.ts$",
      "run": "node --test --test-reporter=junit --test-reporter-destination={junit} {files}" },
    { "dir": "app", "match": "^app/test/.*\\.ac\\.test\\.ts$",
      "run": "npx vitest run --reporter=junit --outputFile.junit={junit} {files}" },
    { "dir": "app", "match": "^app/webkit/.*\\.ac\\.test\\.ts$",
      "run": "PLAYWRIGHT_JUNIT_OUTPUT_NAME={junit} npx playwright test --reporter=junit {files}" },
    { "dir": "app", "match": "^app/e2e/.*\\.ac\\.test\\.ts$",
      "run": "node --test --test-reporter=junit --test-reporter-destination={junit} {files}" }
  ],
  "realAppTests": ["app/e2e/"],
  "budgets": { "commit": 60, "push": 600, "nightly": 5400 }
}
