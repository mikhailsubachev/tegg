{
  "steps": [
    { "id": "qa-tools-typecheck", "dir": "tools/qa", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s1-typecheck", "dir": "spikes/s1-roundtrip", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "qa-tools-test", "dir": "tools/qa",
      "run": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$VERIFY_RESULTS/qa-tools.xml\" 'test/*.test.ts'",
      "level": "push" },
    { "id": "s2-typecheck", "dir": "spikes/s2-editor", "run": "npm run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s2-test", "dir": "spikes/s2-editor",
      "run": "npx vitest run --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/s2-editor.xml\"",
      "level": "push" },
    { "id": "s2-webkit", "dir": "spikes/s2-editor",
      "run": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=\"$VERIFY_RESULTS/s2-webkit.xml\" npx playwright test --project=webkit e2e/editor-flow.spec.ts --reporter=list,junit",
      "level": "nightly" },
    { "id": "s1-test", "dir": "spikes/s1-roundtrip",
      "run": "npx vitest run --reporter=default --reporter=junit --outputFile.junit=\"$VERIFY_RESULTS/s1-roundtrip.xml\"",
      "level": "push" },
    { "id": "s3-typecheck", "dir": "spikes/s3-platform", "run": "npm run --silent typecheck && npm --prefix e2e-appium run --silent typecheck", "level": "commit", "changedOnly": true },
    { "id": "s3-rust-test", "dir": "spikes/s3-platform/src-tauri", "run": "cargo test --quiet", "level": "push" }
  ],
  "acTestPatterns": ["\\.ac\\.test\\.tsx?$", "(^|/)tests/ac_[^/]+\\.rs$"],
  "acRunners": [
    { "dir": "tools/qa", "match": "^tools/qa/test/.*\\.ac\\.test\\.ts$",
      "run": "node --test --test-reporter=junit --test-reporter-destination={junit} {files}" }
  ],
  "budgets": { "commit": 60, "push": 600, "nightly": 5400 }
}
