{
  "permissions": {
    "deny": [
      "Read(./test exports/**)",
      "Edit(./test exports/**)",
      "Write(./test exports/**)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/verify hook claude-pre-tool"
          }
        ]
      }
    ]
  }
}
